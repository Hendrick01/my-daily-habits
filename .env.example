# Endereço base da API de sugestões. Vazio = usa o arquivo do próprio site (public/api/sugestoes.json).
VITE_API_BASE_URL=

# Sincronização e lembretes (Supabase). Sem essas variáveis, o app funciona só no navegador.
# A chave é a "publishable" (pública por natureza); nunca coloque aqui a service_role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave pública VAPID das notificações (a privada fica só nos segredos do Supabase).
VITE_VAPID_PUBLIC_KEY=
